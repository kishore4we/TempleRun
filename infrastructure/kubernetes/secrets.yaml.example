# Example secrets file - DO NOT commit actual secrets to git
# Create actual secrets using: kubectl create secret generic templerun-secrets --from-literal=...

apiVersion: v1
kind: Secret
metadata:
  name: templerun-secrets
type: Opaque
stringData:
  db_user: "postgres"
  db_password: "CHANGE_THIS_PASSWORD"
  jwt_secret: "CHANGE_THIS_JWT_SECRET_MINIMUM_32_CHARACTERS"
  jwt_refresh_secret: "CHANGE_THIS_REFRESH_SECRET_MINIMUM_32_CHARACTERS"
